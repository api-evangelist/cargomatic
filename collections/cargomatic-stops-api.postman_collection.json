          "request": {
            "name": "Mark a stop as \"arrived\"",
            "description": {
              "content": "Marks a stop as \"arrived\". `status`, `stopId`, and `shipmentReference` are required. The only acceptable value for `status` is `arrived` (see example request body). If `date` is not provided, the current time will be used as the arrival time.\nAdmins, shippers, carriers, and drivers are authorized to use this API endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stops",
                "transition"
              ],
              "host": [
                "{{baseUrl}}"
              ],
