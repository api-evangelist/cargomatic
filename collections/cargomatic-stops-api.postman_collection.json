        {
          "id": "93a3aec1-9b31-449e-b354-0a6516d3cf3b",
          "name": "Add additional stops to a shipment",
          "request": {
            "name": "Add additional stops to a shipment",
            "description": {
              "content": "`shipmentReference` and at least one new stop are required. Each new stop must include `address`, `action`, `name`, `sequence`, `windowStart`, `windowEnd`, and other fields dependent on the type of shipment.\nFor US-based clients, the address must include street address, city, state, and zipcode. The `action` is either \"pickup\" or \"delivery\". The sequence number is sequence of the stop within the shipment. The `name` of the stop is the location name. `windowStart` is when the pickup/delivery window starts for that stop. `windowEnd` is when the pickup/delivery window ends for that stop.\nIf the shipment is shorthaul, the new stop must include load data and it must be indicated whether the cargo is a full truckload or not. If the shipment is drayage, the new stop must indicate whether the container is empty or not and location must be included.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "stops",
                "add"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipmentReference\": \"<string>\",\n  \"newStops\": [\n    {\n      \"sequence\": \"<number>\",\n      \"address\": \"<string>\",\n      \"action\": \"<string>\",\n      \"name\": \"<string>\",\n      \"windowStart\": \"<string>\",\n      \"windowEnd\": \"<string>\",\n      \"fullTruckload\": \"<boolean>\",\n      \"isEmptyContainer\": \"<boolean>\",\n      \"loads\": [\n        {\n          \"type\": \"<string>\",\n          \"quantity\": \"<number>\",\n          \"width\": \"<number>\",\n          \"length\": \"<number>\"\n        },\n        {\n          \"type\": \"<string>\",\n          \"quantity\": \"<number>\",\n          \"width\": \"<number>\",\n          \"length\": \"<number>\"\n        }\n      ]\n    },\n    {\n      \"sequence\": \"<number>\",\n      \"address\": \"<string>\",\n      \"action\": \"<string>\",\n      \"name\": \"<string>\",\n      \"windowStart\": \"<string>\",\n      \"windowEnd\": \"<string>\",\n      \"fullTruckload\": \"<boolean>\",\n      \"isEmptyContainer\": \"<boolean>\",\n      \"loads\": [\n        {\n          \"type\": \"<string>\",\n          \"quantity\": \"<number>\",\n          \"width\": \"<number>\",\n          \"length\": \"<number>\"\n        },\n        {\n          \"type\": \"<string>\",\n          \"quantity\": \"<number>\",\n          \"width\": \"<number>\",\n          \"length\": \"<number>\"\n        }\n      ]\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
